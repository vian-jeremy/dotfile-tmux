#!/bin/sh
# Simplified hostname script for TMUX status bar

# Get the hostname (short form by default)
hostname=$(hostname -s 2>/dev/null || hostname)

# If we want to show full hostname in SSH sessions, uncomment below
# if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then
#     hostname=$(hostname -f 2>/dev/null || hostname)
# fi

# Output the hostname
printf '%s' "$hostname"