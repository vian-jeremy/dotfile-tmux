#!/bin/sh
# Simplified username script for TMUX status bar

# Get the current user
username=$(whoami)

# If we want to detect SSH sessions, we can check for SSH environment variables
if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then
    # In SSH session, try to get the original user if different
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "$username" ]; then
        printf '%s@%s' "$SUDO_USER" "$username"
    else
        printf '%s' "$username"
    fi
else
    # Local session
    printf '%s' "$username"
fi